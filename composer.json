{
  "name": "kun/laravel-chat-api",
  "description": "Send messages to Google Chat via webhooks in Laravel",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "google-chat",
    "webhook",
    "notification"
  ],
  "homepage": "https://github.com/bhnghia1012/laravel-chat-api",
  "authors": [
    {
      "name": "bui.nghia",
      "email": "bhnghia1012@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Kun\\LaravelChatApi\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Kun\\LaravelChatApi\\GoogleChatServiceProvider"
      ],
      "aliases": {
        "GoogleChat": "Kun\\LaravelChatApi\\Facades\\GoogleChat"
      }
    }
  }
}
